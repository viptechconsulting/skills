{
  "name": "lynkro-outbound",
  "private": true,
  "version": "0.1.0",
  "description": "Lynkro Outbound - llamadas salientes con IA para prospectos",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "install:all": "pnpm install",
    "dev": "pnpm --parallel --filter=./apps/* run dev",
    "dev:api": "pnpm --filter @lynkro-outbound/api run dev",
    "dev:worker": "pnpm --filter @lynkro-outbound/worker run dev",
    "dev:web": "pnpm --filter @lynkro-outbound/web run dev",
    "build": "pnpm --recursive run build",
    "typecheck": "pnpm --recursive run typecheck",
    "lint": "pnpm --recursive run lint",
    "test": "vitest run --no-file-parallelism",
    "test:watch": "vitest",
    "db:generate": "pnpm --filter @lynkro-outbound/db run generate",
    "db:migrate": "pnpm --filter @lynkro-outbound/db run migrate",
    "db:migrate:deploy": "pnpm --filter @lynkro-outbound/db run migrate:deploy",
    "db:seed": "pnpm --filter @lynkro-outbound/db run seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose build",
    "docker:logs": "docker compose logs -f",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.5",
    "@types/node": "^22.10.1",
    "eslint": "^9.15.0",
    "@eslint/js": "^9.15.0",
    "typescript-eslint": "^8.15.0"
  }
}

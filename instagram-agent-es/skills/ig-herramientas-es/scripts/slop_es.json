 "structures": [
  {
   "id": "not-just",
   "regex": "(?i)\\bno (?:es|son) (?:solo|sólo|solamente|únicamente) [^.!?\\n]{2,60}[,.;]? (?:es|son|sino)\\b",
   "name": "\"No es solo X, es Y\"",
   "fix": "Di la única cosa que de verdad quieres decir. Borra la mitad de preparación."
  },
  {
   "id": "not-only",
   "regex": "(?i)\\bno (?:solo|sólo|solamente)\\b[^.!?\\n]{2,80}\\bsino (?:también|además)\\b",
   "name": "\"No solo X sino también Y\"",
   "fix": "Divide en dos frases o quita la mitad más débil."
  },
  {
   "id": "isnt-about",
   "regex": "(?i)\\bno se trata (?:solo |sólo )?de [^.!?\\n]{2,60}[,.;!]?\\s*(?:sino (?:de|que)|se trata de)\\b",
   "name": "\"No se trata de X, se trata de Y\"",
   "fix": "Abre con Y. El giro es la señal."
  },
  {
   "id": "the-result",
   "regex": "(?i)^\\s*¿?\\s*(?:el resultado|lo mejor|lo mejor de todo|la trampa|el truco)\\s*\\?\\s*$",
   "name": "Pregunta-suspenso (\"¿El resultado?\")",
   "fix": "Respóndela en la misma frase en vez de montar una revelación."
  },
  {
   "id": "heres-what",
   "regex": "(?i)\\besto es lo que (?:aprendí|aprendimos)\\b|\\bestas son las lecciones que\\b",
   "name": "\"Esto es lo que aprendí\"",
   "fix": "Di la lección. Salta el anuncio."
  },
  {
   "id": "triad",
   "regex": "(?i)\\b\\w+, \\w+,? (?:y|e|o) \\w+[.!?]",
   "name": "Tríada \"A, B y C.\"",
   "fix": "Dos elementos o cuatro. Tres es el ritmo por defecto del modelo."
  },
  {
   "id": "rocket",
   "regex": "[\\U0001F680\\U0001F525\\U0001F4A1✨\\U0001F3AF]",
   "name": "Emoji cohete/fuego/bombilla/destello/diana",
   "fix": "Un emoji como máximo, y no uno de estos cinco."
  },
  {
   "id": "hashtag-wall",
   "regex": "(?:#\\w+[ \\t]*){5,}",
   "name": "Muro de hashtags",
   "fix": "Tres hashtags, específicos."
  },

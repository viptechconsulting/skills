# Copie a .env y complete. NUNCA suba secretos al repositorio.
DATABASE_URL=postgres://usuario:clave@host:5432/lopp
PORT=3000
COOKIE_SECURE=1
SESSION_HOURS=12
CRAWL_MAX_PAGES=25
CRAWL_MAX_DEPTH=2
CRAWL_DELAY_MS=300
# Proveedores (vacío = no configurado; nada se simula)
PAGESPEED_API_KEY=
PAGESPEED_ENABLED=1
GOOGLE_PLACES_API_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Costos
DEFAULT_MONTHLY_COST_LIMIT_USD=25
CONFIRM_COST_ABOVE_USD=0
# SOLO pruebas locales (permite rastrear localhost). NUNCA en producción:
# ALLOW_PRIVATE_TARGETS=1

# ============================================================================
# Lynkro Outbound — variables de entorno de ejemplo. NUNCA copie valores
# reales a un repositorio. Copie este archivo a .env y complete los valores.
# ============================================================================

# --- App general ---
NODE_ENV=development
LOG_LEVEL=info
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
# Expuesta al navegador por apps/web (debe apuntar a la misma URL pública de la API)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
PORT_API=4000
PORT_WORKER=4100
PORT_WEB=3000

# --- Seguridad ---
# Generar con: openssl rand -hex 32
JWT_SECRET=
# Generar con: openssl rand -hex 32 (se usa para cifrar credenciales de integraciones en DB con AES-256-GCM)
ENCRYPTION_KEY=
SESSION_COOKIE_NAME=lynkro_session
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Base de datos (Supabase Postgres a través de Prisma) ---
# Ejemplo Supabase: postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres?pgbouncer=true
DATABASE_URL=postgresql://lynkro:lynkro@localhost:5432/lynkro_outbound
# Conexión directa (sin pgbouncer) requerida por Prisma para migraciones en Supabase
DIRECT_URL=postgresql://lynkro:lynkro@localhost:5432/lynkro_outbound
# Solo se usa con docker-compose.prod.yml (VPS) — generar con: openssl rand -hex 24
POSTGRES_PASSWORD=lynkro

# --- Supabase (opcional si solo se usa Postgres directo) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# --- Redis / BullMQ ---
REDIS_URL=redis://localhost:6379

# --- Twilio Programmable Voice + Media Streams ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_DEFAULT_FROM_NUMBER=
# URL pública (ver ngrok/túnel en README) donde Twilio puede alcanzar los webhooks, ej. https://abc123.ngrok.io
TWILIO_WEBHOOK_BASE_URL=http://localhost:4000

# --- OpenAI Realtime API ---
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview

# --- GoHighLevel ---
GHL_BASE_URL=https://services.leadconnectorhq.com
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_SHARED_SECRET=

# --- Modo simulación (no marca teléfonos reales ni gasta créditos de IA) ---
SIMULATION_MODE=true

# --- Cumplimiento / valores por defecto ---
DEFAULT_ALLOWED_CALL_WINDOW_START=09:00
DEFAULT_ALLOWED_CALL_WINDOW_END=19:00
RECORDING_ENABLED_DEFAULT=false
TRANSCRIPT_RETENTION_DAYS=90

# --- Rate limiting ---
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
